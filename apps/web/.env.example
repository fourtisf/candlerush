# Where the Fastify API lives. Must be same-site in production so the session cookie is sent.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match the API's SIWE_DOMAIN / SIWE_URI exactly — a mismatch is treated as a replay
# of a signature harvested by another site.
NEXT_PUBLIC_SIWE_DOMAIN=localhost:3000
NEXT_PUBLIC_SIWE_URI=http://localhost:3000

# VERIFY AGAINST https://docs.robinhood.com/chain BEFORE DEPLOYING.
NEXT_PUBLIC_RHC_CHAIN_ID=
NEXT_PUBLIC_RHC_RPC_URL=

# The contract address shown on the opening screen, copyable in one tap. Leave it empty
# until the token exists and the chip reads COMING SOON. Baked in at build time.
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Absolute origin, used for Open Graph and Twitter card URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
