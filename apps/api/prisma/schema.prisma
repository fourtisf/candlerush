// Two rules that are not negotiable:
//
//   1. Balance is never a mutable column. It is the sum of an append-only ledger.
//      A balance you can UPDATE is a balance you will eventually corrupt, with no way
//      to reconstruct the truth.
//   2. Sessions are immutable once submitted. Never allow resubmission.
//
// Everything below exists to make those two things true at the database level rather
// than merely likely at the application level.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id            String   @id @default(cuid())
  address       String   @unique // lowercased; null-free because guests never get a row
  // A new row is given an anonymous default so the column is never empty, but that is not
  // a name the player chose. `named` is what the client keys off to decide whether to ask.
  name          String
  named         Boolean  @default(false)
  activeChar    String   @default("bull")
  activeMap     String   @default("dawn")
  unlockedChars String[] @default(["bull"])
  unlockedMaps  String[] @default(["dawn"])
  bestSession   Int      @default(0)
  totalSessions Int      @default(0)

  // Adaptive difficulty. Lives here rather than on the client because it feeds the
  // speed ramp: a client-held copy would be a client-side difficulty dial, and every
  // replay would need to take the client's word for it.
  handicap Float @default(0)

  // Consecutive UTC days with a scored session. Display only — it buys nothing, so
  // there is no incentive to game it, and it costs nothing to be wrong about.
  playStreak   Int     @default(0)
  bestStreak   Int     @default(0)
  lastPlayedOn String? // UTC day key, "YYYY-MM-DD"

  flagged   Boolean  @default(false) // suspected automation — never auto-ban
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  ledger   LedgerEntry[]

  @@index([bestSession])
}

model Session {
  id            String        @id @default(cuid())
  playerId      String
  player        Player        @relation(fields: [playerId], references: [id])
  seed          Int
  mapId         String
  charId        String
  handicap      Float         @default(0)
  engineVersion Int

  // Resolved when the session is issued, not read from the table at settle time. A later
  // change to the stake tiers must not retroactively repay a session that was already
  // issued — the same reasoning that keeps `handicap` here.
  stakeId       String        @default("paper")
  stakeCost     Int           @default(0)
  stakeMult     Float         @default(1)
  stakeSettled  Boolean       @default(false) // stake refunded or converted to a payout
  issuedAt      DateTime      @default(now())
  submittedAt   DateTime?
  status        SessionStatus @default(OPEN)

  serverScore Int?
  clientScore Int? // logged for drift detection only, never trusted
  candles     Int?
  levelReached Int?
  bestMult    Int?
  cleanFlips  Int?
  inputCount  Int?
  inputJitterMs Float? // stddev of inter-press gaps — the bot signal
  frames      Int?
  endReason   String?
  wallClockMs Int?

  // The full input tape. Keep it. You will need it — for ghost replays, for challenge
  // links, and for watching a suspicious run back frame by frame.
  replay Json?

  // Final-state fingerprint from the server's own replay. A client/server mismatch is
  // logged, never rejected on: it is the early warning that determinism has broken.
  serverDigest  String?
  clientDigest  String?
  rejectReason  String?

  @@index([playerId, submittedAt])
  @@index([status, issuedAt])
  @@index([submittedAt])
}

enum SessionStatus {
  OPEN
  SUBMITTED
  REJECTED
  EXPIRED
  ABANDONED
}

model LedgerEntry {
  id        String     @id @default(cuid())
  playerId  String
  player    Player     @relation(fields: [playerId], references: [id])
  kind      LedgerKind
  amount    Int // signed: credits positive, purchases negative
  refType   String? // "session" | "unlock" | "admin" | "guest"
  refId     String?
  memo      String?
  createdAt DateTime   @default(now())

  @@unique([refType, refId, kind]) // idempotency: a session can only ever credit once
  @@index([playerId, createdAt])
}

enum LedgerKind {
  SESSION_PAYOUT
  SESSION_STAKE // debited when a session is issued
  SESSION_REFUND // returned when a session never settles into a payout
  UNLOCK_PURCHASE
  TOURNAMENT_PRIZE
  DAILY_PRIZE
  ADJUSTMENT
  GUEST_MIGRATION
}

// One settled day.
//
// Its existence is the whole point: the primary key on `day` is what makes settling a day
// twice impossible, so the close can run lazily off whoever happens to ask first rather
// than off a scheduler that might not be running.
model DailyClose {
  day       String   @id // UTC "YYYY-MM-DD"
  settledAt DateTime @default(now())
  entrants  Int      @default(0)
  paid      Int      @default(0) // total prize money awarded that day

  results DailyResult[]
}

model DailyResult {
  id       String     @id @default(cuid())
  day      String
  close    DailyClose @relation(fields: [day], references: [day], onDelete: Cascade)
  rank     Int
  playerId String
  name     String // snapshotted: a rename must not rewrite who won on a past day
  score    Int
  prize    Int    @default(0)

  @@unique([day, rank])
  @@index([playerId])
}
