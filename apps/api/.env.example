# ── runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── stores ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://candlerush:candlerush@127.0.0.1:5432/candlerush
REDIS_URL=redis://127.0.0.1:6379

# ── auth ──────────────────────────────────────────────────────────────────────
# At least 32 characters. Rotating it invalidates every signed-in session, which is
# exactly what you want if it ever leaks.
JWT_SECRET=change-me-to-something-long-and-random-at-least-32-chars
JWT_TTL_DAYS=7
COOKIE_NAME=cr_session
COOKIE_SECURE=false
# COOKIE_DOMAIN=.candlerush.gg

CORS_ORIGINS=http://localhost:3000

# The domain and URI a SIWE message must claim. A message naming a different domain is
# a signature harvested by another site being replayed here.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_STATEMENT=Sign in to Candle Rush.

# ── chain ─────────────────────────────────────────────────────────────────────
# VERIFY THESE AGAINST https://docs.robinhood.com/chain BEFORE DEPLOYING.
# Deliberately has no default: a wrong chain id silently accepts signatures that were
# scoped to a different network. RHC_RPC_URL is only needed for smart-contract wallets
# (ERC-1271); plain EOA signatures verify locally without it.
RHC_CHAIN_ID=
RHC_RPC_URL=

# ── replay guard rails ────────────────────────────────────────────────────────
# A 90s session cannot be played faster than ~80s. Anything slower than the ceiling was
# most likely being computed rather than played. Note that pausing counts against this.
SESSION_MIN_ELAPSED_MS=80000
SESSION_MAX_ELAPSED_MS=300000
REPLAY_TIMEOUT_MS=2000
REPLAY_WORKERS=2

SESSION_START_PER_HOUR_PLAYER=20
SESSION_START_PER_HOUR_IP=60

# Input-timing stddev below this (ms) flags an account for human review. Never bans.
JITTER_FLAG_MS=8

# Ceiling on the one-time guest balance carry-over.
GUEST_MIGRATION_CAP=50000
